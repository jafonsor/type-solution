# Loads the project's dev shell (flake devShells.default) on cd, via
# nix-direnv, which caches it and keeps it from being garbage-collected.
#
# --accept-flake-config: direnv runs nix non-interactively, so the flake's
#   nixConfig (the reflex-frp and IOG binary caches) can't be prompted for;
#   without it nix ignores them and builds the toolchain from source.
# fallback: build locally instead of failing when a cache is unreachable.
# builders '': the system nix.conf names a linux-builder VM; nothing here
#   needs it, and a stopped VM only slows builds down.
watch_file project.nix default.nix shell.nix inputs.nix
use flake . --accept-flake-config --option fallback true --option builders ''
